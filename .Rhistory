end_line <- length(model_output)
cat(model_output[start_line:end_line], sep = "\n")
library(forecast)
library(dplyr)
library(ggplot2)
# 0) 准备 ts（只含数值列，月频）
ts_b <- ts(df_brent %>% dplyr::select(Port_TEUs, Brent),
start = c(2015, 10), frequency = 12)
# 1) 参数
data <- ts_b
n <- nrow(data)
h <- 12
k <- floor(n / 3 / h) * h
num_iter <- (n - k) / h
st <- tsp(data)[1] + (k - 1) / h
# 2) 容器（每个迭代给出1:h步的误差）
rmse1 <- matrix(NA_real_, nrow = num_iter, ncol = h)  # ARIMA(0,1,1)(0,1,1)[12]
rmse2 <- matrix(NA_real_, nrow = num_iter, ncol = h)  # ARIMA(2,0,0)(2,0,0)[12]
# 3) Walk-forward 验证
for (i in 1:num_iter) {
xtrain <- window(data, end = st + i - 1)
xtest  <- window(data, start = st + (i - 1) + 1/frequency(data), end = st + i)
## 模型1：ARIMA(0,1,1)(0,1,1)[12] + Brent
m1 <- Arima(xtrain[, "Port_TEUs"],
order = c(0,1,1),
seasonal = list(order = c(0,1,1), period = 12),
xreg = xtrain[, "Brent", drop = FALSE],
optim.control = list(maxit = 10000))
f1 <- forecast(m1, h = h, xreg = xtest[, "Brent", drop = FALSE])
rmse1[i, ] <- (as.numeric(f1$mean) - as.numeric(xtest[, "Port_TEUs"]))^2
## 模型2：ARIMA(2,0,0)(2,0,0)[12] + Brent
m2 <- Arima(xtrain[, "Port_TEUs"],
order = c(2,0,0),
seasonal = list(order = c(2,0,0), period = 12),
xreg = xtrain[, "Brent", drop = FALSE],
optim.control = list(maxit = 10000))
f2 <- forecast(m2, h = h, xreg = xtest[, "Brent", drop = FALSE])
rmse2[i, ] <- (as.numeric(f2$mean) - as.numeric(xtest[, "Port_TEUs"]))^2
}
# 安全拟合函数：先尝试目标阶数，失败则自动降阶
fit_sarimax_safe <- function(y, x, order_main, order_seasonal, period = 12) {
tryCatch(
{
Arima(y,
order = order_main,
seasonal = list(order = order_seasonal, period = period),
xreg = x,
method = "ML",               # 避免 CSS 阶段卡住
transform.pars = FALSE,      # 关闭参数变换，减少不稳定
optim.control = list(maxit = 10000))
},
error = function(e) {
message("Model ", paste0("(", paste(order_main, collapse=","), ")(",
paste(order_seasonal, collapse=","), ")[", period, "]"),
" failed: ", conditionMessage(e),
" -> fallback to lower seasonal AR.")
# 降一阶季节性 AR：例如 (2,0,0) 变为 (1,0,0)
new_seasonal <- c(min(order_seasonal[1], 1), order_seasonal[2], order_seasonal[3])
Arima(y,
order = order_main,
seasonal = list(order = new_seasonal, period = period),
xreg = x,
method = "ML",
transform.pars = FALSE,
optim.control = list(maxit = 10000))
}
)
}
