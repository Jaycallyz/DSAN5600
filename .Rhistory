# Step 1: Prepare data
log.b <- log(djt$Adjusted)
returns <- diff(log.b)
# Set rolling window parameters
k <- 4000  # 80% of data length as initial training size
n <- length(returns)
# Initialize error storage
err1 <- c()  # ARIMA(1,1,0) + GARCH(1,1)
err2 <- c()  # GARCH(1,1)
# Rolling forecast loop
for (i in 1:(n - k)) {
# Training and test data
xtrain <- log.b[1:(k - 1) + i]
xtest <- log.b[k + i]
## Model 1: ARIMA(1,1,0) + GARCH(1,1) on residuals
arima.fit <- Arima(xtrain, order = c(1,1,0), include.drift = TRUE)
arima.res <- residuals(arima.fit)
fit1 <- garchFit(~ garch(1, 1), data = arima.res, trace = FALSE)
fcast1 <- predict(fit1, n.ahead = 1)
## Model 2: GARCH(1,1) on returns
returns_train <- diff(xtrain)
fit2 <- garchFit(~ garch(1, 1), data = returns_train, trace = FALSE)
fcast2 <- predict(fit2, n.ahead = 1)
# Forecasting log price (meanForecast is on returns, so add to last value of xtrain)
pred1 <- tail(xtrain, 1) + fcast1$meanForecast
pred2 <- tail(xtrain, 1) + fcast2$meanForecast
# Squared errors for each model
err1 <- c(err1, (pred1 - xtest)^2)
err2 <- c(err2, (pred2 - xtest)^2)
}
# Step 1: Prepare data
log.b <- log(djt$Adjusted)
returns <- diff(log.b)
# Set rolling window parameters
k <- 4000  # 80% of data length as initial training size
n <- length(returns)
# Initialize error storage
err1 <- c()  # ARIMA(1,1,0) + GARCH(1,1)
err2 <- c()  # GARCH(1,1)
# Rolling forecast loop
for (i in 1:(n - k)) {
# Training and test data
xtrain <- log.b[1:(k - 1) + i]
xtest <- log.b[k + i]
## Model 1: ARIMA(1,1,0) + GARCH(1,1) on residuals
arima.fit <- Arima(xtrain, order = c(1,1,0), include.drift = TRUE)
arima.res <- residuals(arima.fit)
fit1 <- garchFit(~ garch(1, 1), data = arima.res, trace = FALSE)
fcast1 <- predict(fit1, n.ahead = 1)
## Model 2: GARCH(1,1) on returns
returns_train <- diff(xtrain)
fit2 <- garchFit(~ garch(1, 1), data = returns_train, trace = FALSE)
fcast2 <- predict(fit2, n.ahead = 1)
# Forecasting log price (meanForecast is on returns, so add to last value of xtrain)
pred1 <- tail(xtrain, 1) + fcast1$meanForecast
pred2 <- tail(xtrain, 1) + fcast2$meanForecast
# Squared errors for each model
err1 <- c(err1, (pred1 - xtest)^2)
err2 <- c(err2, (pred2 - xtest)^2)
}
log.b   <- log(djt$Adjusted)
returns <- diff(log.b)
n  <- length(log.b)
test_len <- 500          # 只滚动 500 次
k <- n - test_len        # 前面 n - 500 当作初始训练长度
err1 <- numeric(test_len)
err2 <- numeric(test_len)
for (i in 1:test_len) {
xtrain <- log.b[i:(i + k - 1)]
xtest  <- log.b[i + k]
# Model 1: ARIMA(1,1,0) + GARCH(1,1)
arima.fit <- Arima(xtrain, order = c(1,1,0), include.drift = TRUE)
arima.res <- residuals(arima.fit)
fit1   <- garchFit(~ garch(1, 1), data = arima.res, trace = FALSE)
garch1 <- predict(fit1, n.ahead = 1)$meanForecast
arima_fc <- forecast(arima.fit, h = 1)$mean[1]
pred1 <- arima_fc + garch1
# Model 2: GARCH(1,1) on returns
returns_train <- diff(xtrain)
fit2    <- garchFit(~ garch(1, 1), data = returns_train, trace = FALSE)
ret_fc2 <- predict(fit2, n.ahead = 1)$meanForecast
pred2   <- tail(xtrain, 1) + ret_fc2
err1[i] <- (pred1 - xtest)^2
err2[i] <- (pred2 - xtest)^2
}
log.b   <- log(djt$Adjusted)
returns <- diff(log.b)
n  <- length(log.b)
print(n)
log.b   <- log(djt$Adjusted)
returns <- diff(log.b)
n  <- length(log.b)
# 前 80% 训练，后 20% 测试
train_end <- floor(0.8 * n)
train <- log.b[1:train_end]
test  <- log.b[(train_end + 1):n]
# Model 1: ARIMA(1,1,0) + GARCH(1,1)
arima.fit <- Arima(train, order = c(1,1,0), include.drift = TRUE)
arima.res <- residuals(arima.fit)
fit1      <- garchFit(~ garch(1, 1), data = arima.res, trace = FALSE)
# 直接多步预测
fc_arima  <- forecast(arima.fit, h = length(test))$mean
fc_garch1 <- predict(fit1, n.ahead = length(test))$meanForecast
pred1     <- fc_arima + fc_garch1
# Model 2: GARCH(1,1) on returns
ret_train <- diff(train)
fit2      <- garchFit(~ garch(1, 1), data = ret_train, trace = FALSE)
ret_fc2   <- predict(fit2, n.ahead = length(test))$meanForecast
# 累积回 log 价格
pred2 <- numeric(length(test))
pred2[1] <- tail(train, 1) + ret_fc2[1]
for (i in 2:length(test)) {
pred2[i] <- pred2[i-1] + ret_fc2[i]
}
RMSE1 <- sqrt(mean((pred1 - test)^2))
RMSE2 <- sqrt(mean((pred2 - test)^2))
tabel <- data.frame(
Model = c("ARIMA(1,1,0)+GARCH(1,1)", "GARCH(1,1)"),
RMSE = round(c(RMSE1, RMSE2), 4)
)
highlight_row <- which.min(tabel$RMSE)
kable(tabel, align = 'c', caption = "Model Comparison Based on RMSE") %>%
kable_styling(full_width = FALSE, position = "center") %>%
row_spec(highlight_row, bold = TRUE, background = "#FFFF99")
# Extract the conditional variances from GARCH
ht <- garch_model@h.t
# Create dataframe and plot
vol_df <- data.frame(Date = djt$Date, Volatility = ht)
p <- ggplot(vol_df, aes(x = Date, y = Volatility)) +
geom_line(color = "#9999cc") +
labs(
title = "Volatility Plot (Conditional Variance from GARCH Model)",
x = "Date",
y = "Conditional Variance"
) +
theme_minimal()
ggplotly(p)
