# 必要包
library(dplyr)
library(lubridate)
library(zoo)
library(forecast)  # 提供 autoplot(stl/decompose)
library(ggplot2)
## 1) 日频聚合为月频（补 NA → 按月取“最后一个有效值”）
usd_monthly <- usd %>%
arrange(Date) %>%
mutate(Index = zoo::na.approx(Index, na.rm = FALSE)) %>%   # 线性插值内部 NA
mutate(ym = as.yearmon(Date)) %>%
group_by(ym) %>%
summarise(Index = dplyr::last(na.locf(Index, na.rm = FALSE)), .groups = "drop")
## （可选）限定时间窗口
usd_monthly <- usd_monthly %>%
filter(ym >= as.yearmon("2015-10") & ym <= as.yearmon("2024-12"))
## 2) 构造月频 ts（frequency = 12）
start_year  <- as.integer(floor(min(usd_monthly$ym)))
start_month <- as.integer(round((min(usd_monthly$ym) - start_year) * 12 + 1))
usd_ts <- ts(usd_monthly$Index, start = c(start_year, start_month), frequency = 12)
## 3) 对数 + STL 分解（更稳健）
usd_stl <- stl(log(usd_ts), s.window = "periodic", robust = TRUE)
autoplot(usd_stl) + ggtitle("STL Decomposition – U.S. Dollar Index (log)")
## （可选）经典乘性分解
usd_dec <- decompose(log(usd_ts), type = "multiplicative")
autoplot(usd_dec) + ggtitle("Classical Decomposition – U.S. Dollar Index (log)")
library(dplyr)
library(lubridate)
library(zoo)
library(forecast)
library(ggplot2)
usd_monthly <- usd %>%
arrange(Date) %>%
mutate(Index = zoo::na.approx(Index, na.rm = FALSE)) %>%
mutate(ym = as.yearmon(Date)) %>%
group_by(ym) %>%
summarise(Index = dplyr::last(na.locf(Index, na.rm = FALSE)), .groups = "drop")
usd_monthly <- usd_monthly %>%
filter(ym >= as.yearmon("2015-10") & ym <= as.yearmon("2024-12"))
start_year  <- as.integer(floor(min(usd_monthly$ym)))
start_month <- as.integer(round((min(usd_monthly$ym) - start_year) * 12 + 1))
usd_ts <- ts(usd_monthly$Index, start = c(start_year, start_month), frequency = 12)
usd_dec <- decompose(log(usd_ts), type = "multiplicative")
autoplot(usd_dec) + ggtitle("Classical Decomposition – U.S. Dollar Index (log)")
